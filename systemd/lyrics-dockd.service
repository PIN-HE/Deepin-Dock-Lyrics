[Unit]
Description=Deepin Dock Lyrics background service
Documentation=https://github.com/ojijibo/deepin-dock-lyrics
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.deepin.LyricsDock1
ExecStart=/usr/lib/deepin-dock-lyrics/lyrics-dockd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
